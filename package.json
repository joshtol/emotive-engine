{
  "type": "module",
  "name": "@joshtol/emotive-engine",
  "version": "3.4.2",
  "description": "Open-source animation engine for AI-controlled emotional visualizations with musical time synchronization",
  "main": "dist/emotive-mascot.umd.js",
  "module": "dist/mascot.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/mascot.js",
      "require": "./dist/emotive-mascot.umd.js"
    },
    "./3d": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d.js",
      "require": "./dist/emotive-mascot-3d.umd.js"
    },
    "./3d-elementals": {
      "types": "./types/3d-elementals.d.ts",
      "import": "./dist/emotive-mascot-3d-elementals.js",
      "require": "./dist/emotive-mascot-3d-elementals.umd.js"
    },
    "./3d-fire": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-fire.js"
    },
    "./3d-water": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-water.js"
    },
    "./3d-ice": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-ice.js"
    },
    "./3d-electric": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-electric.js"
    },
    "./3d-earth": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-earth.js"
    },
    "./3d-nature": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-nature.js"
    },
    "./3d-light": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-light.js"
    },
    "./3d-void": {
      "types": "./types/3d.d.ts",
      "import": "./dist/emotive-mascot-3d-void.js"
    },
    "./minimal": {
      "types": "./types/minimal.d.ts",
      "import": "./dist/emotive-mascot.minimal.js",
      "require": "./dist/emotive-mascot.minimal.umd.js"
    },
    "./lean": {
      "types": "./types/lean.d.ts",
      "import": "./dist/emotive-mascot.lean.js",
      "require": "./dist/emotive-mascot.lean.umd.js",
      "default": "./dist/emotive-mascot.lean.umd.js"
    },
    "./package.json": "./package.json"
  },
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist/mascot.js",
    "dist/emotive-mascot.umd.js",
    "dist/emotive-mascot-3d.js",
    "dist/emotive-mascot-3d.umd.js",
    "dist/emotive-mascot-3d-elementals.js",
    "dist/emotive-mascot-3d-elementals.umd.js",
    "dist/emotive-mascot-3d-fire.js",
    "dist/emotive-mascot-3d-water.js",
    "dist/emotive-mascot-3d-ice.js",
    "dist/emotive-mascot-3d-electric.js",
    "dist/emotive-mascot-3d-earth.js",
    "dist/emotive-mascot-3d-nature.js",
    "dist/emotive-mascot-3d-light.js",
    "dist/emotive-mascot-3d-void.js",
    "dist/emotive-mascot.minimal.js",
    "dist/emotive-mascot.minimal.umd.js",
    "dist/emotive-mascot.lean.js",
    "dist/emotive-mascot.lean.umd.js",
    "types",
    "assets/emotive-engine-icon.svg",
    "assets/emotive-engine-full-BW.svg",
    "README.md",
    "LICENSE.md",
    "docs/THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "build": "rollup -c --environment NODE_ENV:production && node scripts/copy-built-files.js",
    "build:dev": "rollup -c --environment NODE_ENV:development",
    "build:watch": "rollup -c -w --environment NODE_ENV:development",
    "dev": "cd site && npm run dev",
    "serve": "cd site && python -m http.server 5000",
    "local": "node scripts/local-server.js",
    "build:analyze": "rollup -c --environment NODE_ENV:production,ANALYZE:true",
    "copy-files": "node scripts/copy-built-files.js",
    "build:docs": "node scripts/build-docs.js",
    "optimize": "node scripts/optimize-bundle.js",
    "docs": "jsdoc -c docs/jsdoc.json",
    "docs:api": "typedoc --options docs/typedoc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:core": "vitest run test/unit/core",
    "test:utils": "vitest run test/unit/utils",
    "test:renderer": "vitest run test/unit/core/renderer",
    "bench": "vitest bench",
    "bench:watch": "vitest bench --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\"",
    "size": "node scripts/check-bundle-size.js",
    "size:report": "node scripts/report-sizes.js",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('dist', {recursive: true, force: true}))\"",
    "prepublishOnly": "npm run clean && npm run build",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "prepare": "husky || true"
  },
  "keywords": [
    "animation",
    "canvas",
    "canvas2d",
    "webgl",
    "threejs",
    "3d",
    "particle-system",
    "particle-animation",
    "visual-effects",
    "emotional-animation",
    "character-animation",
    "mascot",
    "ui-animation",
    "interactive",
    "real-time",
    "high-performance",
    "ai-assistant",
    "llm",
    "chatbot",
    "conversational-ui",
    "sentiment-visualization",
    "emotion",
    "emotional-intelligence",
    "gesture-animation",
    "shape-morphing",
    "javascript",
    "open-source",
    "mit-license",
    "audio-reactive",
    "music-visualization",
    "beat-detection",
    "user-engagement"
  ],
  "author": "Joshua Tollette",
  "license": "MIT",
  "homepage": "https://github.com/joshtol/emotive-engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshtol/emotive-engine.git"
  },
  "bugs": {
    "url": "https://github.com/joshtol/emotive-engine/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": [
    "src/3d/effects/ElementRegistrations.js",
    "src/3d/effects/elements/*.js",
    "src/core/gestures/elemental-gestures.js",
    "src/core/gestures/elemental/*/register.js",
    "**/ElementRegistrations.js",
    "**/effects/elements/*.js",
    "**/elemental-gestures.js",
    "**/elemental/*/register.js"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@gltf-transform/cli": "^4.3.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "canvas": "^3.2.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "gif.js": "^0.2.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.4",
    "jsdoc-to-markdown": "^9.1.2",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup": "^4.9.5",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-bundle-size": "^1.0.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.46.1",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.11.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
